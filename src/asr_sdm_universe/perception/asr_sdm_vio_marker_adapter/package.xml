<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>asr_sdm_vio_marker_adapter</name>
  <version>0.0.0</version>
  <description>Adapts VIO output topics to ESDF map input:
    - keyframe_point (PointCloud) -> /localization/video_inertial_odom/points (Marker)
    All conversions use standard pcl_conversions; no hand-packed PointCloud2 fields.</description>
  <maintainer email="lxy@example.com">lxy</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>nav_msgs</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
