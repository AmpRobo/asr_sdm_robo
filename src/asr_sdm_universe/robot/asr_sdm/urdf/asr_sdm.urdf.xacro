<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="asr_sdm">

  <!-- 当前机器人固定为 4 个主体节段和 3 组节段间关节。 -->
  <xacro:property name="N" value="4"/>

  <!-- 相邻节段的固定连接变换。 -->
  <xacro:property name="CONNECT_XYZ" value="-0.046790 -0.000087 -0.018248"/>
  <xacro:property name="CONNECT_RPY" value="1.5707963267948966 0 -1.5707963267948966"/>

  <!-- ================= 最小运动学/刚体动力学参数 ================= -->
  <!-- XM430-W350：初始仿真限制。机械角限位取较保守的 ±1 rad。 -->
  <xacro:property name="SERVO_LOWER" value="-1.0"/>
  <xacro:property name="SERVO_UPPER" value="1.0"/>
  <xacro:property name="SERVO_EFFORT" value="4.0"/>
  <xacro:property name="SERVO_VELOCITY" value="4.82"/>

  <!-- 螺旋转子：缺少实际电机型号时采用的初始仿真值。 -->
  <!-- 20.943951 rad/s = 200 rpm；0.10 N·m 仅为保守仿真上限。 -->
  <xacro:property name="ROTOR_EFFORT" value="0.10"/>
  <xacro:property name="ROTOR_VELOCITY" value="20.9439510239"/>

  <!-- ================= 单个节段 ================= -->
  <!-- 每节均包含主体和两个螺旋转子；末节不包含 A/Cross/B 关节单元。 -->
  <xacro:macro name="snake_segment" params="idx parent:=''">

    <!-- 每个节段的主体和两个螺旋转子。 -->
        <link name="screwdrive_segment_${idx}">
            <collision>
              
              <origin rpy="0 0 0" xyz="0.0 0.0 0.08725" />
              <geometry>
                <cylinder length="0.1855000000000001" radius="0.03" />
              </geometry>
            </collision>
            <inertial>
              <mass value="0.3426319676894056" />
              <origin rpy="0 0 0" xyz="-6.77842e-05 0.000168756 0.0781638" />
              <inertia ixx="0.0008368145831015" ixy="3.348578885e-07" ixz="1.3959146972e-06" iyy="0.0008365215316531" iyz="4.092756065e-07" izz="0.0001491920058212" />
            </inertial>
          <visual><origin rpy="0 0 0" xyz="0 0 0" /><geometry><mesh filename="package://asr_sdm/meshes/screwdrive_segment_0.stl" /></geometry><material name="mat_screwdrive_segment_${idx}"><color rgba="0.678431 0.709804 0.741176 1" /></material></visual></link>
        <link name="screw_rotor_left_${idx}">
            <collision>
              
              <origin rpy="-2.98023224e-08 0 0" xyz="0.0 0.0 0.0" />
              <geometry>
                <cylinder length="0.0255" radius="0.047" />
              </geometry>
            </collision>
            <inertial>
              <mass value="0.0329179650724561" />
              <origin rpy="-2.98023224e-08 0 0" xyz="0.0 0.0 0.0" />
              <inertia ixx="1.94327521911e-05" ixy="8.165e-13" ixz="-2.5e-15" iyy="1.94376384386e-05" iyz="-1.817e-13" izz="3.56879993201e-05" />
            </inertial>
          <visual><origin rpy="0 0 0" xyz="0 0 0" /><geometry><mesh filename="package://asr_sdm/meshes/screw_rotor_left_0.stl" /></geometry><material name="mat_screw_rotor_left_${idx}"><color rgba="0.678431 0.709804 0.741176 1" /></material></visual></link>
        <link name="screw_rotor_right_${idx}">
            <collision>
              
              <origin rpy="0 0 0" xyz="0.0 0.0 0.0" />
              <geometry>
                <cylinder length="0.0255" radius="0.047" />
              </geometry>
            </collision>
            <inertial>
              <mass value="0.0329145282292943" />
              <origin rpy="0 0 0" xyz="0.0 0.0 0.0" />
              <inertia ixx="1.94322695895e-05" ixy="8.147e-13" ixz="5.3e-15" iyy="1.94371557899e-05" iyz="1.806e-13" izz="3.5687294149e-05" />
            </inertial>
          <visual><origin rpy="0 0 0" xyz="0 0 0" /><geometry><mesh filename="package://asr_sdm/meshes/screw_rotor_right_0.stl" /></geometry><material name="mat_screw_rotor_right_${idx}"><color rgba="0.678431 0.709804 0.741176 1" /></material></visual></link>
        <joint name="joint_screwdrive_segment_0__screw_rotor_left_0__${idx}" type="continuous">
            <parent link="screwdrive_segment_${idx}" />
            <child link="screw_rotor_left_${idx}" />
            <origin rpy="0 0 0" xyz="0.0 0.0 0.01275" />
            <axis xyz="0 0 1" />
            <limit effort="${ROTOR_EFFORT}" velocity="${ROTOR_VELOCITY}" />
          </joint>
        <joint name="joint_screwdrive_segment_0__screw_rotor_right_0__${idx}" type="continuous">
            <parent link="screwdrive_segment_${idx}" />
            <child link="screw_rotor_right_${idx}" />
            <origin rpy="0 0 0" xyz="0.0 0.0 0.0825" />
            <axis xyz="0 0 1" />
            <limit effort="${ROTOR_EFFORT}" velocity="${ROTOR_VELOCITY}" />
          </joint>

    <!-- A / Cross / B 关节单元，末节跳过。 -->
    <xacro:if value="${idx + 1 &lt; int(N)}">
            <link name="joint_unit_a_${idx}">
              <!-- XM430-W350 与输出/从动侧安装附件的等效质量属性。 -->
              <!-- 质量取 0.105 kg；惯量由 82 g STL 均匀分布结果按质量线性缩放。 -->
              <inertial>
                <mass value="0.105" />
                <origin rpy="0 0 0" xyz="-0.000354695736 -0.0000183839643 0.0219250269" />
                <inertia
                  ixx="3.69265338786e-05"
                  ixy="-2.40610257648e-08"
                  ixz="2.33629298824e-07"
                  iyy="4.06736219268e-05"
                  iyz="-2.83212124166e-08"
                  izz="2.47155849478e-05" />
              </inertial>
              <visual>
                <origin rpy="0 0 0" xyz="0 0 0" />
                <geometry>
                  <mesh filename="package://asr_sdm/meshes/joint_unit_a.stl" />
                </geometry>
                <material name="mat_joint_unit_a_${idx}">
                  <color rgba="0.678431 0.709804 0.741176 1" />
                </material>
              </visual>
            </link>
            <link name="joint_unit_cross_${idx}">
              <!-- 两个 FR12-H101K 正交连接及紧固件的等效质量属性。 -->
              <!-- 质量取 0.020 kg；质心和惯量由组合 STL 的均匀质量分布计算。 -->
              <inertial>
                <mass value="0.020" />
                <origin rpy="0 0 0" xyz="0.000313986224 -0.018982444334 0.019003452419" />
                <inertia
                  ixx="3.85136165390e-06"
                  ixy="-2.56677722305e-08"
                  ixz="7.13023772897e-13"
                  iyy="5.90814768259e-06"
                  iyz="-3.88597622857e-13"
                  izz="3.85104301667e-06" />
              </inertial>
              <visual>
                <origin rpy="0 0 0" xyz="0 0 0" />
                <geometry>
                  <mesh filename="package://asr_sdm/meshes/joint_unit_cross.stl" />
                </geometry>
                <material name="mat_joint_unit_cross_${idx}">
                  <color rgba="0.678431 0.709804 0.741176 1" />
                </material>
              </visual>
            </link>
            <link name="joint_unit_b_${idx}">
              <!-- XM430-W350 与输出/从动侧安装附件的等效质量属性。 -->
              <!-- 质量取 0.105 kg；惯量由 82 g STL 均匀分布结果按质量线性缩放。 -->
              <inertial>
                <mass value="0.105" />
                <origin rpy="0 0 0" xyz="-0.0169779299 0.000139808905 -0.0186162548" />
                <inertia
                  ixx="2.36615114444e-05"
                  ixy="1.11368664330e-07"
                  ixz="-5.46313091894e-07"
                  iyy="3.97164045384e-05"
                  iyz="8.17139817483e-10"
                  izz="3.57206534120e-05" />
              </inertial>
              <visual>
                <origin rpy="0 0 0" xyz="0 0 0" />
                <geometry>
                  <mesh filename="package://asr_sdm/meshes/joint_unit_b.stl" />
                </geometry>
                <material name="mat_joint_unit_b_${idx}">
                  <color rgba="0.678431 0.709804 0.741176 1" />
                </material>
              </visual>
            </link>
            <joint name="joint_screwdrive_segment_0__joint_unit_a__${idx}" type="fixed">
                <parent link="screwdrive_segment_${idx}" />
                <child link="joint_unit_a_${idx}" />
                <origin rpy="0 0 0" xyz="4.323e-05 0.0 0.177" />
              </joint>
            <joint name="joint_joint_unit_a__joint_unit_cross__${idx}" type="revolute">
                <parent link="joint_unit_a_${idx}" />
                <child link="joint_unit_cross_${idx}" />
                <origin rpy="-1.5707963267948966 0 -1.5707963267948966" xyz="-0.0190035 -8.38634e-05 0.0392499" />
                <axis xyz="0 0 1" />
                <limit effort="${SERVO_EFFORT}" lower="${SERVO_LOWER}" upper="${SERVO_UPPER}" velocity="${SERVO_VELOCITY}" />
              </joint>
            <joint name="joint_joint_unit_cross__joint_unit_b__${idx}" type="revolute">
                <parent link="joint_unit_cross_${idx}" />
                <child link="joint_unit_b_${idx}" />
                <origin rpy="-1.5707963267948968 0 1.5707963267948966" xyz="-0.018332 -0.03796 0.018873" />
                <axis xyz="0 0 1" />
                <limit effort="${SERVO_EFFORT}" lower="${SERVO_LOWER}" upper="${SERVO_UPPER}" velocity="${SERVO_VELOCITY}" />
              </joint>
    </xacro:if>

    <!-- 连接到上一节，根节段跳过。 -->
    <xacro:unless value="${parent == ''}">
      <joint name="joint_connect_${idx}" type="fixed">
        <parent link="joint_unit_b_${parent}"/>
        <child link="screwdrive_segment_${idx}"/>
        <origin rpy="${CONNECT_RPY}" xyz="${CONNECT_XYZ}"/>
      </joint>
    </xacro:unless>
  </xacro:macro>

  <!-- ================= 递归生成 N 个节段 ================= -->
  <xacro:macro name="snake_chain" params="idx:=0 parent:=''">
    <xacro:snake_segment idx="${idx}" parent="${parent}"/>
    <xacro:if value="${idx + 1 &lt; int(N)}">
      <xacro:snake_chain idx="${idx + 1}" parent="${idx}"/>
    </xacro:if>
  </xacro:macro>

  <xacro:snake_chain/>

  <!-- base 与控制器 / 2D Pose Estimate 一致：+X 朝前、+Y 朝左、+Z 朝上。 -->
  <link name="base"/>
  <joint name="base_to_base_link" type="fixed">
    <parent link="base"/>
    <child link="base_link"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
  </joint>

  <!-- CAD 沿节段 +Z 建模，头部朝向为 -Z。 -->
  <!-- 绕 Y 转 -π/2，使头部朝向变为 base_link +X。 -->
  <link name="base_link"/>
  <joint name="base_link_to_screwdrive_segment_0" type="fixed">
    <parent link="base_link"/>
    <child link="screwdrive_segment_0"/>
    <origin rpy="0 -1.5707963267948966 0" xyz="0 0 0"/>
  </joint>
</robot>
