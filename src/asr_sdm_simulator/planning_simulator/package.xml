<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>planning_simulator</name>
  <version>0.0.0</version>
  <description>ASR-SDM kinematic and legacy quadrotor simulation launch stack.</description>
  <maintainer email="todo@todo.todo">Kartik Mohta</maintainer>
  <license>BSD</license>
  <url>http://ros.org/wiki/planning_simulator</url>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>quadrotor_msgs</depend>
  <depend>uav_utils</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>eigen</depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>asr_sdm</exec_depend>
  <exec_depend>asr_sdm_controller</exec_depend>
  <exec_depend>asr_sdm_map_generator</exec_depend>
  <exec_depend>asr_sdm_teleop</exec_depend>
  <exec_depend>joy</exec_depend>
  <exec_depend>so3_control</exec_depend>
  <exec_depend>so3_disturbance_generator</exec_depend>
  <exec_depend>odom_visualization</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>rviz_plugins</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
