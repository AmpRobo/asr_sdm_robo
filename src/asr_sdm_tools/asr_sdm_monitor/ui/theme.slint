// Visual tokens and UI copy for the monitor. `zh` switches every `t()` lookup.

export global AppTheme {
    in-out property <bool> dark: true;

    // Dark colors are a deep navy. Chart painting uses the same surface, grid, and text values.
    out property <color> window-background: dark ? #0b1220 : #ffffff;
    out property <color> sidebar-background: dark ? #0e182b : #f8fbff;
    out property <color> content-background: dark ? #0b1220 : #ffffff;
    out property <color> surface-background: dark ? #16263d : #ffffff;
    out property <color> header-background: dark ? #101a2e : #f5f8fc;
    out property <color> input-background: dark ? #091018 : #ffffff;
    out property <color> row-alt: dark ? #122033 : #fbfdff;
    out property <color> border: dark ? #2c4060 : #dbe4ef;
    out property <color> text-primary: dark ? #e7eef8 : #1e2b3a;
    out property <color> text-secondary: dark ? #8fa3bf : #607285;
    out property <color> accent: dark ? #5b9dff : #2a6df4;
    out property <color> accent-text: #ffffff;
    out property <color> danger: #c42b1c;
    out property <color> card-value: dark ? #d7e6f8 : #32465a;
    out property <color> selected-nav: dark ? #1a3a66 : #edf4ff;
}

export global AppText {
    in-out property <bool> zh: false;

    public pure function t(key: string) -> string {
        if (key == "appTitle") { return zh ? "ASR SDM 监控界面" : "ASR SDM Monitor"; }
        if (key == "theme") { return zh ? "主题" : "Theme"; }
        if (key == "language") { return zh ? "语言" : "Language"; }
        if (key == "darkTheme") { return zh ? "深色主题" : "dark theme"; }
        if (key == "lightTheme") { return zh ? "浅色主题" : "light theme"; }
        if (key == "english") { return "English"; }
        if (key == "chinese") { return "中文"; }
        if (key == "hardware") { return zh ? "硬件" : "Hardware"; }
        if (key == "video") { return zh ? "视频" : "Video"; }
        if (key == "plot") { return zh ? "绘图" : "Plot"; }
        if (key == "simulator") { return zh ? "仿真" : "Simulator"; }
