        if (key == "topicSortNameAscending") { return zh ? "名称正序 A–Z" : "Name A–Z"; }
        if (key == "topicSortNameDescending") { return zh ? "名称倒序 Z–A" : "Name Z–A"; }
        if (key == "topicSortSource") { return zh ? "话题来源" : "Source"; }
        if (key == "topicSortPlottableFirst") { return zh ? "可绘图优先" : "Plottable first"; }
        if (key == "unifiedTopicCandidateHint") { return zh ? "这里同时展示 ROS 2 实时话题和正在播放的数据包话题。同一话题名称只能选择一个来源；Recorded 打开数据包后会直接读取其中全部可绘图话题。" : "ROS 2 Live and active ros2 bag play topics are shown here. Only one source can be selected for the same topic name. Recorded reads all plottable topics directly when a bag is opened."; }
        if (key == "topicName") { return zh ? "话题" : "Topic"; }
        if (key == "topicType") { return zh ? "类型" : "Type"; }
        if (key == "topicSource") { return zh ? "来源" : "Source"; }
        if (key == "topicCapability") { return zh ? "能力" : "Capability"; }
        if (key == "plotHint") { return zh ? "时间序列图使用时间作为 X 轴，话题消息字段作为 Y 轴。XY 图使用话题消息字段分别作为 X 轴和 Y 轴。" : "Time series uses time as X and a topic message field as Y. XY plot uses topic message fields for both X and Y."; }
        if (key == "recordingFile") { return zh ? "录制文件" : "Recording Bag"; }
        if (key == "startRecording") { return zh ? "开始录制" : "Start Recording"; }
        if (key == "stopRecording") { return zh ? "停止录制" : "Stop Recording"; }
        if (key == "resetView") { return zh ? "重置视野" : "Reset"; }
