        if (key == "expandSidebar") { return zh ? "展开侧边栏" : "Expand sidebar"; }
        if (key == "minimize") { return zh ? "最小化" : "Minimize"; }
        if (key == "maximize") { return zh ? "最大化" : "Maximize"; }
        if (key == "restoreDown") { return zh ? "向下还原" : "Restore Down"; }
        if (key == "close") { return zh ? "关闭" : "Close"; }
        if (key == "cpu") { return "CPU"; }
