        if (key == "square") { return zh ? "等比例" : "Square"; }
        if (key == "waitingPlotData") { return zh ? "等待选中的绘图话题数据 ..." : "Waiting for selected plot topic data ..."; }
        if (key == "recordedFile") { return zh ? "回放文件" : "Recorded Bag"; }
