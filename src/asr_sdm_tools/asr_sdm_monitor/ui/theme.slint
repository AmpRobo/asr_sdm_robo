        if (key == "pause") { return zh ? "暂停" : "Pause"; }
        if (key == "browse") { return zh ? "浏览" : "Browse"; }
        if (key == "simulatorHint") { return zh ? "选择 planning_simulator 或 logging_simulator。RViz 在单独窗口打开。未在这里列出的 launch 参数沿用各自的默认值。" : "Choose planning_simulator or logging_simulator. RViz opens in its own window. Launch arguments not listed here keep that launch file's defaults."; }
        if (key == "simulatorKind") { return zh ? "仿真" : "Simulator"; }
        if (key == "simulatorLaunchCommand") { return zh ? "启动命令" : "Launch command"; }
        if (key == "simulatorStart") { return zh ? "启动" : "Start"; }
