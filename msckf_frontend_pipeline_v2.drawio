        <mxCell id="lg5t" value="EKF / MSCKF Filter" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="130" y="625" width="140" height="20" as="geometry" />
