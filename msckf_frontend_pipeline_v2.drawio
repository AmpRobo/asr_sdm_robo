        <mxCell id="lg4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00" vertex="1" parent="1">
          <mxGeometry x="260" y="590" width="20" height="20" as="geometry" />
