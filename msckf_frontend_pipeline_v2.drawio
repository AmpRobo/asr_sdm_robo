        <mxCell id="lg1t" value="Inputs / Outputs" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="130" y="555" width="120" height="20" as="geometry" />
