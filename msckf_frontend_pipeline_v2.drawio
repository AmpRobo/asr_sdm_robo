<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" agent="Cursor" version="24.0.0">
  <diagram name="MSCKF-Frontend" id="msckf-frontend-pipeline">
    <mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="MSCKF Frontend Pipeline" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="500" y="20" width="400" height="40" as="geometry" />
        </mxCell>

        <!-- Input Group: Camera + IMU -->
        <mxCell id="input_camera" value="Camera Image&#10;I_k" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="80" y="120" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="input_imu" value="IMU Measurements&#10;(ω_k, a_k)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="80" y="220" width="140" height="60" as="geometry" />
        </mxCell>

        <!-- Harris Corner Detection -->
        <mxCell id="harris" value="Harris Corner&#10;Detection" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="300" y="120" width="140" height="60" as="geometry" />
        </mxCell>

        <!-- LK Optical Flow Tracking -->
        <mxCell id="lk_flow" value="LK Optical Flow&#10;Tracking" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="520" y="120" width="140" height="60" as="geometry" />
        </mxCell>

        <!-- KLT Tracker -->
        <mxCell id="klt" value="KLT Tracker&#10;(feature tracking)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="740" y="120" width="160" height="60" as="geometry" />
        </mxCell>

        <!-- Feature Tracks Buffer -->
        <mxCell id="tracks" value="Feature Tracks&#10;(multi-frame observations)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="980" y="110" width="160" height="80" as="geometry" />
        </mxCell>

        <!-- MSCKF Triangulation -->
        <mxCell id="triangulation" value="MSCKF Feature&#10;Triangulation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="980" y="240" width="160" height="60" as="geometry" />
        </mxCell>

        <!-- Sliding Window Filter (EKF) -->
        <mxCell id="ekf" value="Sliding Window EKF&#10;(MSCKF Update)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="980" y="370" width="160" height="70" as="geometry" />
        </mxCell>

        <!-- IMU Preintegration (feeding EKF) -->
        <mxCell id="imu_preint" value="IMU Preintegration&#10;(propagation)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="740" y="375" width="160" height="60" as="geometry" />
        </mxCell>

        <!-- Outputs -->
        <mxCell id="out_pose" value="Camera Pose&#10;T_k = [R_k | p_k]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1220" y="370" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="out_map" value="Map Points&#10;(3D landmarks)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1220" y="460" width="160" height="80" as="geometry" />
        </mxCell>

        <!-- Edges -->
        <!-- Camera -> Harris -->
        <mxCell id="e1" style="endArrow=classic;html=1;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeWidth=2" edge="1" parent="1" source="input_camera" target="harris" />
        <!-- Harris -> LK -->
        <mxCell id="e2" style="endArrow=classic;html=1;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeWidth=2" edge="1" parent="1" source="harris" target="lk_flow" />
        <!-- LK -> KLT -->
        <mxCell id="e3" style="endArrow=classic;html=1;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeWidth=2" edge="1" parent="1" source="lk_flow" target="klt" />
        <!-- KLT -> Feature Tracks buffer -->
        <mxCell id="e4" style="endArrow=classic;html=1;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeWidth=2" edge="1" parent="1" source="klt" target="tracks" />
        <!-- Feature Tracks -> Triangulation -->
        <mxCell id="e5" style="endArrow=classic;html=1;rounded=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeWidth=2" edge="1" parent="1" source="tracks" target="triangulation" />
        <!-- Triangulation -> EKF -->
        <mxCell id="e6" style="endArrow=classic;html=1;rounded=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeWidth=2" edge="1" parent="1" source="triangulation" target="ekf" />
        <!-- EKF -> Pose -->
        <mxCell id="e7" style="endArrow=classic;html=1;rounded=0;exitX=1;exitY=0.3;entryX=0;entryY=0.5;strokeWidth=2" edge="1" parent="1" source="ekf" target="out_pose" />
        <!-- EKF -> Map Points -->
        <mxCell id="e8" style="endArrow=classic;html=1;rounded=0;exitX=1;exitY=0.7;entryX=0;entryY=0.5;strokeWidth=2" edge="1" parent="1" source="ekf" target="out_map" />
        <!-- IMU -> IMU Preintegration -->
        <mxCell id="e9" style="endArrow=classic;html=1;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeWidth=2" edge="1" parent="1" source="input_imu" target="imu_preint" />
        <!-- IMU Preintegration -> EKF -->
        <mxCell id="e10" style="endArrow=classic;html=1;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeWidth=2" edge="1" parent="1" source="imu_preint" target="ekf" />

        <!-- Loop edge: KLT feedback (tracking continues to next frame) -->
        <mxCell id="e_loop" style="endArrow=classic;html=1;rounded=1;exitX=0.5;exitY=1;entryX=0.5;entryY=1;strokeWidth=2;dashed=1;strokeColor=#666666" edge="1" parent="1" source="klt" target="harris">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="820" y="280" />
              <mxPoint x="370" y="280" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Legend -->
        <mxCell id="legend_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1" vertex="1" parent="1">
          <mxGeometry x="80" y="520" width="520" height="150" as="geometry" />
        </mxCell>
        <mxCell id="legend_title" value="Legend" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="90" y="525" width="80" height="20" as="geometry" />
